# Copy this file to .env and adjust if needed. Every default already works
# with zero paid services — you only need to change this for production.

DATABASE_URL=sqlite:///./krushisarthi.db
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=["*"]

# Mandi prices (Agmarknet via data.gov.in). Optional — the code defaults to
# the sample key published in data.gov.in's own API docs, which works but is
# shared and rate-limited. Register a free key at data.gov.in for real use.
# Sentinel-2 NDVI needs NO key at all (AWS Open Data mirror).
DATA_GOV_API_KEY=

# Required only for the advisory agent (Phase 4, POST /api/advisory/ask).
# Free tier available at console.groq.com. Everything else in this backend
# works with zero API keys.
GROQ_API_KEY=
# Verified against the live /models list on 2026-09-22 — Groq's free-tier
# lineup changes over time, so if this 404s, list what's currently available:
#   .venv\Scripts\python -c "from groq import Groq; from app.core.config import get_settings; [print(m.id) for m in Groq(api_key=get_settings().groq_api_key).models.list().data]"
# openai/gpt-oss-20b is a faster/cheaper alternative if -120b is slow.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: where runtime state lives. Defaults are inside backend/; on
# Render these point at the persistent disk (see render.yaml).
# AGENT_CHECKPOINT_DB=/var/data/agent_checkpoints.db
# STATIC_DIR=/var/data/static
